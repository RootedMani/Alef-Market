# Copy to .env and fill in. .env is gitignored; this file is committed and has NO secrets.
# Every variable starts with ALEF_. Defaults live in app/settings.py.

ALEF_ENV=dev                      # dev | demo | test | prod
ALEF_LOG_LEVEL=INFO
ALEF_MOCK_API=true                # true = endpoints not built yet return example data

ALEF_MARKET_MODE=replay           # replay (demo default) | live
ALEF_EXCHANGE=binance             # decided in Week 0 by the connectivity test
ALEF_EXCHANGE_TIMEOUT_MS=10000
# ALEF_EXCHANGE_PROXY=http://127.0.0.1:10809   # only if the exchange is reachable via a local proxy

# LLM: comma-separated keys per provider, tried in this order.
ALEF_LLM_PROVIDER_ORDER=["groq","gemini","openrouter"]
ALEF_LLM_CACHE_MODE=fallback      # prefer (demo day) | fallback (dev) | only (offline rehearsal)
ALEF_GROQ_KEYS=
ALEF_GEMINI_KEYS=
ALEF_OPENROUTER_KEYS=
